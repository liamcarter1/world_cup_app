# --- Database ---
# Local dev (zero-config): SQLite
DATABASE_URL="file:./dev.db"
# Production (Vercel + Neon): set this to your Neon Postgres URL and change the
# datasource provider in prisma/schema.prisma to "postgresql".
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Live scores (optional) ---
# API-Football key from https://www.api-football.com/ (free tier = 100 req/day).
# If unset, the app runs on the bundled seed snapshot (no live scores).
# FOOTBALL_API_KEY=your_api_football_key
# FOOTBALL_API_BASE="https://v3.football.api-sports.io"

# --- Security ---
# Protects the cron sync endpoint (Vercel Cron sends this as a Bearer token).
# CRON_SECRET=change-me
# Gates the manual "Sync scores" action in /admin.
ADMIN_PASSWORD="alltogethernow"

NEXT_PUBLIC_APP_NAME="All together now"
